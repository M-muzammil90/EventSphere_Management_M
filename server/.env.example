# EventSphere Backend Environment Variables (Template — Do NOT commit real secrets)

NODE_ENV=development
PORT=5000
MONGO_URI=mongodb://localhost:27017/eventsphere

# Authentication & Security (minimum 32 chars for JWT_SECRET)
JWT_SECRET=replace_with_a_strong_32_plus_char_random_secret
JWT_EXPIRES_IN=7d
JWT_COOKIE_NAME=es_token
JWT_COOKIE_SECURE=false
JWT_COOKIE_SAME_SITE=lax

# CORS & Frontend Origin
CLIENT_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Payments (demo | live)
PAYMENT_MODE=demo
DEV_PAYMENT_MODE=true
DEFAULT_TAX_RATE=5
CURRENCY=USD

# Optional Payment Gateways (Required when PAYMENT_MODE=live)
PAYFAST_MERCHANT_ID=
PAYFAST_SECURED_KEY=
PAYFAST_MERCHANT_NAME=EventSphere Management
PAYFAST_ENV=sandbox

JAZZCASH_MERCHANT_ID=
JAZZCASH_PASSWORD=
JAZZCASH_INTEGRITY_SALT=

EASYPAISA_STORE_ID=
EASYPAISA_HASH_KEY=

# Optional Cloudinary File Uploads (Falls back to local /uploads if unset)
CLOUDINARY_CLOUD_NAME=qka5wdzc
CLOUDINARY_API_KEY=467293874981246
CLOUDINARY_API_SECRET=CLOUDINARY_URL=cloudinary://467293874981246:M5cN2C490-Da32hOawYPm62ePr4@qka5wdzc

# Optional SMTP Email (Logs to console if unset)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=no-reply@eventsphere.io

# Seed Admin Account (Used by npm run seed)
SEED_ADMIN_NAME=EventSphere Owner
SEED_ADMIN_EMAIL=admin@eventsphere.io
SEED_ADMIN_PASSWORD=ChangeMe!2026
