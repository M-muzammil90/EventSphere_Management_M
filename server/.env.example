# =====================================================================
# EventSphere API — environment variables
# =====================================================================
# Copy this file to `.env` and replace the placeholder values.
# NEVER commit a real .env to version control.

# ----------------------------- Runtime ------------------------------
NODE_ENV=development
PORT=5000

# --------------------------- Local MongoDB --------------------------
# Default local MongoDB on Windows (MongoDB Community Server).
# Start the service first:  net start MongoDB   (or run mongod.exe)
MONGO_URI=mongodb://127.0.0.1:27017/eventsphere

# Test database (in-memory server is used automatically by Jest)
MONGO_URI_TEST=mongodb://127.0.0.1:27017/eventsphere_test

# ------------------------------- JWT -------------------------------
# Generate a strong secret:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=REPLACE_WITH_A_LONG_RANDOM_SECRET_MIN_32_CHARS
JWT_EXPIRES_IN=7d
JWT_COOKIE_NAME=es_token
# Set to true only when serving over HTTPS
JWT_COOKIE_SECURE=false
JWT_COOKIE_SAME_SITE=lax

# ------------------------------ CORS -------------------------------
# Comma-separated allowlist. In development this must match your Vite dev origin.
CLIENT_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---------------------------- Cloudinary ---------------------------
# Optional. Leave blank to use local disk storage (uploads/ folder) instead.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=eventsphere

# ---------------------------- Rate limits --------------------------
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=20

# ----------------------------- Payments ----------------------------
# DEMO mode records payments WITHOUT any gateway verification.
# LIVE mode requires real gateway credentials and is not implemented.
PAYMENT_MODE=demo
DEFAULT_TAX_RATE=5
CURRENCY=USD

# ---------------------------- Seed admin ---------------------------
# Used only by `npm run seed` to create the first Admin account.
# CHANGE THESE IMMEDIATELY AFTER FIRST LOGIN.
SEED_ADMIN_NAME=EventSphere Owner
SEED_ADMIN_EMAIL=admin@eventsphere.io
SEED_ADMIN_PASSWORD=ChangeMe!2026

# ------------------------------ Email ------------------------------
# Optional. When SMTP is not configured, emails are logged to the console.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=no-reply@eventsphere.io
