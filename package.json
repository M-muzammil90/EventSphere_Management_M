{
  "name": "react-vite-tailwind",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n \"server,client\" -c \"blue,green\" \"npm --prefix server run dev\" \"vite\"",
    "dev:client": "vite",
    "dev:server": "npm --prefix server run dev",
    "seed": "npm --prefix server run seed",
    "seed:fresh": "npm --prefix server run seed:fresh",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@hookform/resolvers": "^7.0.7",
    "axios": "^1.21.1",
    "clsx": "2.1.1",
    "framer-motion": "^14.14.0",
    "lucide-react": "^1.75.0",
    "nodemailer": "^10.6.0",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "react-hook-form": "^7.92.0",
    "react-router-dom": "^7.18.6",
    "socket.io-client": "^4.8.4",
    "tailwind-merge": "3.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.1.17",
    "@testing-library/jest-dom": "^8.0.0",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.13",
    "@types/node": "22.19.17",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "5.1.1",
    "concurrently": "^10.0.7",
    "jsdom": "^31.0.1",
    "tailwindcss": "4.1.17",
    "typescript": "5.9.3",
    "vite": "7.3.7",
    "vite-plugin-singlefile": "2.3.0",
    "vitest": "^5.1.1"
  }
}
